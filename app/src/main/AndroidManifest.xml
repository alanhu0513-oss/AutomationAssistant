<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Update check talks to the public GitHub Releases API (fail-soft, no tracking). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the "Keep protection running" action open the battery-exemption
         dialog — the core keep-alive feature of the shield. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!-- Foreground service: keeps the shield engine alive during long matches. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ runtime permission for the persistent shield notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Visibility rule 1: list the launchable apps shown in the game picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Visibility rule 2: resolve the home/launcher package so we never
             dismiss the user's own home screen as if it were a popup. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
        <!-- Visibility rule 3: resolve the default dialer so an incoming call
             is never mistaken for an interrupting layer. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".ShieldApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aegis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Aegis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".automation.OverlayAutomationService"
            android:exported="true"
            android:foregroundServiceType="specialUse|dataSync"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <!-- specialUse justification: the persistent notification keeps the
                 accessibility engine alive while a game is in the foreground. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent notification keeps the accessibility-based game shield alive during active gameplay so Android does not recycle the process." />
        </service>

        <!-- Quick Settings tile: mirror shield state, jump to the right place. -->
        <service
            android:name=".automation.ShieldTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.TileService" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

    </application>
</manifest>
