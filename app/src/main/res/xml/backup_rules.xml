<?xml version="1.0" encoding="utf-8"?>
<!--
   Pre-Android 12 backup rules. Backup and device-to-device transfer are
   disabled outright via android:allowBackup="false"; this file satisfies
   the API 26-31 attribute requirement and mirrors that intent.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
