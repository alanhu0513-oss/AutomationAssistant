<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer stay off: the app only keeps
     local preferences (protected games, shield log, settings) that are
     recreated on the new device during onboarding. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
