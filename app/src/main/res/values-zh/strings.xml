<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Gaming Shield</string>
    <string name="accessibility_service_label">Shield 引擎</string>
    <string name="accessibility_service_description">监视出现在你所选游戏上方的系统弹窗、时限拦截和家长控制界面，并自动关闭它们。适用于所有 Android 品牌。不读取、不存储、不发送任何内容。</string>

    <!-- Dashboard -->
    <string name="dashboard_title">Gaming Shield</string>

    <!-- Status card -->
    <string name="status_standby_title">引擎待机</string>
    <string name="status_standby_hint">滑动下方开关以唤醒护盾。</string>
    <string name="status_waiting_title">未选择游戏</string>
    <string name="status_waiting_hint">点按下方的游戏以启用保护。</string>
    <string name="status_operational_title">护盾运行中</string>
    <string name="status_operational_hint">游戏上方出现的拦截界面会被自动关闭。</string>
    <string name="status_blocked_count">已拦截弹窗：%1$d</string>
    <string name="keep_running">保持保护持续运行</string>

    <!-- Sliding toggle -->
    <string name="toggle_shield_on">护盾：开启</string>
    <string name="toggle_shield_off">护盾：关闭</string>
    <string name="toggle_hint">打开手机的无障碍设置</string>

    <!-- Game picker -->
    <string name="games_section_title">选择你的游戏</string>
    <string name="games_search_hint">查找应用</string>
    <string name="games_loading">正在加载你的应用…</string>
    <string name="games_empty">未找到应用</string>
    <string name="games_no_results">没有匹配的应用</string>

    <!-- System capabilities & limits (transparency) -->
    <string name="capabilities_section_title">系统能力与限制</string>
    <string name="capability_perfect_label">它能完美做到的事</string>
    <string name="capability_perfect_body">自动检测并关闭厂商时限浮层等表层弹窗——例如标准的 VIVO、小米和 OPPO 弹窗计时器——方式是即时模拟系统「返回」命令。</string>
    <string name="capability_limit_label">它无法做到的事（限制）</string>
    <string name="capability_limit_body">如果 Android 系统完全冻结了后台第三方进程，或停用了无障碍层，它无法绕过深度内核级锁或严格的平台拦截（例如 Google Family Link）。</string>
    <string name="capability_slow_label">1% 法则</string>
    <string name="capability_slow_body">如果你的手机在运行《三角洲行动》等大型游戏时严重卡顿或内存不足，护盾的反应可能需要零点几秒。</string>

    <!-- Per-game strictness (reaction level) -->
    <string name="strictness_normal">标准</string>
    <string name="strictness_gentle">温和</string>
    <string name="strictness_strict">灵敏</string>

    <!-- Preview mode -->
    <string name="preview_title">预览模式</string>
    <string name="preview_body">仅观察并记录游戏上方的弹窗而不关闭它们——精确查看护盾会拦截哪些内容。</string>

    <!-- Shield activity log -->
    <string name="log_section_title">护盾动态</string>
    <string name="log_empty">还没有关闭过弹窗——你的护盾很安静。</string>
    <string name="log_clear">清空</string>
    <string name="log_unknown_app">系统浮层</string>
    <string name="log_entry_subtitle">在 %1$s 之上 · %2$s</string>
    <plurals name="log_overflow">
        <item quantity="other">+ %1$d 条更早的记录</item>
    </plurals>

    <!-- Offline watchdog banner -->
    <string name="offline_title">护盾已离线</string>
    <string name="offline_body">Android 或手机的电池管理器关闭了无障碍服务。在重新开启之前，护盾无法保护你的游戏。</string>
    <string name="offline_action">重新开启</string>

    <!-- Device health / OEM survival guide -->
    <string name="health_title">让护盾保持存活</string>
    <string name="health_detected">检测到的设备：%1$s</string>
    <string name="health_intro">各手机品牌把电池设置藏在不同的位置。请按照你设备对应的路径操作——不同系统版本的菜单名称可能略有差异。</string>
    <string name="health_open_battery">打开电池设置</string>
    <string name="brand_miui">小米 / Redmi / POCO（MIUI 与 HyperOS）</string>
    <string name="brand_coloros">OPPO / realme / 一加（ColorOS）</string>
    <string name="brand_oneui">三星（One UI）</string>
    <string name="brand_funtouch">vivo / iQOO（Funtouch 与 OriginOS）</string>
    <string name="brand_stock">原生 Android / Pixel</string>
    <string name="health_miui_1">打开「手机管家」→ 电量 → 省电模式</string>
    <string name="health_miui_2">找到 Gaming Shield 并设置为「无限制」</string>
    <string name="health_miui_3">设置 → 应用设置 → 应用管理 → Gaming Shield → 开启「自启动」</string>
    <string name="health_coloros_1">设置 → 应用 → 应用管理 → Gaming Shield</string>
    <string name="health_coloros_2">耗电保护 → 开启「允许后台运行」</string>
    <string name="health_coloros_3">启动管理 → 允许「自动启动」与「后台运行」</string>
    <string name="health_oneui_1">设置 → 电池 → 后台使用限制</string>
    <string name="health_oneui_2">打开「休眠应用」→「永不休眠的应用」→ 添加 Gaming Shield</string>
    <string name="health_oneui_3">关闭「闲置应用自动休眠」对护盾的限制</string>
    <string name="health_funtouch_1">打开「i管家」→ 省电模式（或设置 → 电池）</string>
    <string name="health_funtouch_2">后台耗电管理 → Gaming Shield → 允许</string>
    <string name="health_funtouch_3">加速白名单 → 添加 Gaming Shield</string>
    <string name="health_stock_1">设置 → 应用 → Gaming Shield → 电池</string>
    <string name="health_stock_2">将「电池用量」设置为「不受限制」</string>
    <string name="health_stock_3">关闭电池优化，让护盾永不休眠</string>

    <!-- Update notice (only shown when a new version exists) -->
    <string name="update_title">更新已就绪</string>
    <string name="update_body">版本 %1$s 已发布。</string>
    <string name="update_action">立即更新</string>

    <!-- Friendly error snackbars -->
    <string name="error_apps_load">无法加载你的应用，请重新打开此页面。</string>
    <string name="error_engine">护盾遇到一点问题——已记录日志，仍在运行。</string>

    <!-- Notification permission dialog -->
    <string name="notif_dialog_title">让护盾保持存活</string>
    <string name="notif_dialog_body">为确保护盾在长时间对局中保持活跃，请允许发送通知。</string>
    <string name="notif_dialog_allow">允许</string>
    <string name="notif_dialog_later">稍后再说</string>

    <!-- Persistent foreground notification -->
    <string name="notif_channel_name">Gaming Shield 运行中</string>
    <string name="notif_title">Gaming Shield</string>
    <string name="notif_text">Gaming Shield 正在运行并持续监控。</string>

    <!-- Onboarding · slide 1 -->
    <string name="slide1_title">你的 Gaming Shield</string>
    <string name="slide1_body">本应用是一面后台护盾。当你畅玩喜爱的游戏时，它会安静地保持警惕，留意突然出现的系统时限拦截。</string>
    <string name="slide1_next">下一步</string>

    <!-- Onboarding · slide 2 -->
    <string name="slide2_title">第 1 步：授予权限</string>
    <string name="slide2_body">要快速关闭拦截界面，本应用需要相应权限。点按下方按钮，在「已安装的服务」或「无障碍」中找到我们的应用名称，并将其开启。</string>
    <string name="slide2_grant">授予设置权限</string>
    <string name="slide2_next">下一步</string>

    <!-- Onboarding · slide 3 -->
    <string name="slide3_title">第 2 步：锁定护盾</string>
    <string name="slide3_body">Android 系统为节省电量总喜欢关闭后台应用。要让护盾保持活跃，请打开手机的多任务菜单，长按本应用卡片，然后点按「锁定」挂锁图标。</string>
    <string name="slide3_finish">开始游戏！</string>

    <string name="cd_app_icon">应用图标</string>
</resources>
